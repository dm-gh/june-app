PORT=3000
DATABASE_URL=postgres://june:june@localhost:5432/june
# Public origin of the app; Better Auth builds its callback URLs from it. In development this is the Vite
# dev server, which proxies /api to the api, so the Google callback lands on the same origin as the app.
BASE_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud console → OAuth client (web); redirect URI is $BASE_URL/api/auth/callback/google (http://localhost:5173/... in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://openexchangerates.org, free plan
OPEN_EXCHANGE_RATES_APP_ID=
# Built web app to serve as static files. Unset in development: Vite serves the web app and proxies /api.
# WEB_DIST=../web/dist
